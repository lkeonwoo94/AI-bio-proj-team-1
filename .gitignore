# --- 데이터 (저장소 밖에 둔다. configs/data.yaml 의 data_root 참조) ---
/data/
*.csv.gz
*.parquet
*.h5

# raw DepMap CSV 는 용량이 크므로 절대 커밋하지 않는다.
# results/tables/*.csv 는 분석 산출물이므로 예외로 추적한다.
/**/OmicsSomaticMutationsMatrix*.csv
/**/OmicsGlobalSignatures.csv
/**/Model.csv
!results/tables/*.csv

