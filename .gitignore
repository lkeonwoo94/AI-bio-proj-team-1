# --- 데이터 ---
# 데이터 파일은 data/ 안에 두되 git 에는 올리지 않는다.
# 용량(GitHub 파일당 100MB)과 재배포 정책 문제를 원천적으로 피하기 위함이다.
# 어떤 파일을 어디서 받아야 하는지는 data/depmap/README.md 와
# configs/data.yaml 에 기록해 공유한다.
data/*
!data/depmap/
data/depmap/*
!data/depmap/README.md
!data/gdc/
data/gdc/*
!data/gdc/README.md
!data/reference/
data/reference/*
!data/reference/README.md

# --- 캐시 ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.cache/
.pytest_cache/
.ruff_cache/

# --- 환경 ---
.venv/
venv/
.env

# --- OS / 에디터 ---
.DS_Store
*.Zone.Identifier
.vscode/
.idea/
